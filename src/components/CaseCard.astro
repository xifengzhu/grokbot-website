---
import { pick, type Localized } from '../content/copy';
import type { CaseImage, CaseLink } from '../content/cases';
import type { Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  name: string;
  type: Localized;
  summary: Localized;
  links: CaseLink[];
  media: CaseImage[];
}

const { locale, name, type, summary, links, media } = Astro.props;
---

<article class="case-card">
  <div class:list={['case-media', { 'case-media--dual': media.length > 1 }]}>
    {
      media.map((image) =>
        image.mobileSrc ? (
          <picture>
            <source media="(max-width: 720px)" srcset={image.mobileSrc} />
            <img src={image.src} alt={pick(locale, image.alt)} />
          </picture>
        ) : (
          <img src={image.src} alt={pick(locale, image.alt)} />
        ),
      )
    }
  </div>
  <div class="case-body">
    <p class="tag">{pick(locale, type)}</p>
    <h3>{name}</h3>
    <p>{pick(locale, summary)}</p>
    {
      links.length > 0 && (
        <div class="case-links">
          {links.map((link) => (
            <a href={link.href} rel="noopener noreferrer" target="_blank">
              {pick(locale, link.label)}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
