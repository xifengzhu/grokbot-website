---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import { homeCases } from '../content/cases';
import { copy, pick } from '../content/copy';
import { pathFor, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} page="home">
  <div class="wrap">
    <section class="hero">
      <div>
        <p class="kicker">{pick(locale, copy.common.brandDisplay)}</p>
        <h1>{pick(locale, copy.home.tagline)}</h1>
        <p class="subhead">{pick(locale, copy.home.subhead)}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={pathFor('contact', locale)}>{pick(locale, copy.home.cta)}</a>
          <a class="btn btn-ghost" href={pathFor('services', locale)}>{pick(locale, copy.home.ctaSecondary)}</a>
        </div>
      </div>
      <figure class="hero-visual">
        <img src="/brand/hero-og.jpg" alt={pick(locale, copy.common.brandDisplay)} width="1200" height="630" />
      </figure>
    </section>

    <section class="section" aria-labelledby="services-intro">
      <div class="section-head">
        <div>
          <h2 id="services-intro">{pick(locale, copy.home.servicesIntro)}</h2>
          <p class="lede">{pick(locale, copy.home.servicesIntroBody)}</p>
        </div>
        <a href={pathFor('services', locale)}>{pick(locale, copy.common.learnMore)}</a>
      </div>
      <div class="service-rail" aria-label={pick(locale, copy.home.servicesIntro)}>
        {
          copy.services.items.map((item, index) => (
            <a href={`${pathFor('services', locale)}#${item.id}`}>
              <span class="num">{String(index + 1).padStart(2, '0')}</span>
              <span>{pick(locale, item.title)}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="cases-intro">
      <div class="section-head">
        <div>
          <h2 id="cases-intro">{pick(locale, copy.home.casesIntro)}</h2>
          <p class="lede">{pick(locale, copy.home.casesIntroBody)}</p>
        </div>
        <a href={pathFor('cases', locale)}>{pick(locale, copy.home.casesViewAll)}</a>
      </div>
      <div class="case-grid case-grid--home">
        {
          homeCases.map((item) => (
            <CaseCard
              locale={locale}
              name={item.name}
              type={item.type}
              summary={item.summary}
              links={item.links}
              media={item.media}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
